<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_bg"
    android:orientation="vertical">

    <!-- Top App Bar (Material You) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="TizenDLNA"
                android:textColor="@color/m3_on_surface"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tv_server_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Starting DLNA server..."
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_toggle_server"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill_tonal"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="Stop Server"
            android:textAllCaps="false"
            android:textColor="@color/m3_on_secondary_container"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_quit"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill_error"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="Quit"
            android:textAllCaps="false"
            android:textColor="@color/m3_on_error_container"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- TV Selector Card (Material You tonal surface) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_card_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="TV"
            android:src="@drawable/ic_tv" />

        <TextView
            android:id="@+id/tv_selected_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Scanning Wi-Fi for Samsung TVs..."
            android:textColor="@color/m3_on_surface"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_scan_tv"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_primary"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="Scan TV"
            android:textAllCaps="false"
            android:textColor="@color/m3_on_primary_container"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- All Files Access Banner -->
    <LinearLayout
        android:id="@+id/permission_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_pill_error"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Allow All Files Access to browse folders and auto-load same-folder subtitles."
            android:textColor="@color/m3_on_error_container"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_grant_files"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Allow"
            android:textAllCaps="false"
            android:textColor="@color/m3_on_error_container"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- File Manager Path Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/btn_up_dir"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Up folder"
            android:src="@drawable/ic_arrow_up" />

        <TextView
            android:id="@+id/tv_current_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="Internal Storage"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_home_dir"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Root"
            android:textAllCaps="false"
            android:textColor="@color/m3_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/m3_outline_variant" />

    <!-- Empty Directory Hint -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="32dp"
        android:text="This folder is empty."
        android:textColor="@color/m3_on_surface_variant"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- File Manager List -->
    <ListView
        android:id="@+id/file_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@color/m3_outline_variant"
        android:dividerHeight="0.5dp"
        android:fastScrollEnabled="true"
        android:paddingBottom="8dp" />

    <!-- Now Playing Material You Bottom Card -->
    <LinearLayout
        android:id="@+id/now_playing_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_now_playing"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_now_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/m3_on_surface"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_now_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/m3_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00 / 0:00"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_rew"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="-15s"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_surface"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_play_pause"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_pill_primary"
                android:stateListAnimator="@null"
                android:text="Pause"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_primary_container"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_fwd"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="+15s"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_surface"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_stop"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_error_container"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_vol_down"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="0.8"
                android:text="V-"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_vol_up"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="0.8"
                android:text="V+"
                android:textAllCaps="false"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
